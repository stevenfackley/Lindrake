# ============================================================
# Lindrake — Environment Variables Template
# Copy this file to .env.dev, .env.test, or .env.prod and fill in values.
# Never commit .env or .env.prod — they contain real secrets.
#
# Names with "__" are .NET configuration keys (Section__Key, case-insensitive)
# and reach the API as-is through env_file. The UPPER_CASE names below are
# mapped to .NET keys by docker-compose.yml via ${...} interpolation, which reads
# the Compose environment, not env_file. docker-compose.yml defaults each of them
# to its .env.dev value; run `docker compose --env-file .env.dev` to apply edits.
# In production, docker-compose.prod.yml loads .env.prod only (no .env.dev and
# none of the base file's dev mappings); API keys, JWT secret, connection string
# and the superuser password come from secrets/*.txt.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=lindrake
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lindrake
# .env.prod: set POSTGRES_USER and POSTGRES_DB, leave POSTGRES_PASSWORD out.
# The prod overlay blanks it and passes POSTGRES_PASSWORD_FILE instead.

# Password of lindrake_app, the non-superuser, RLS-bound role the API connects
# as; infra/db/init.sql creates it on the first start of an empty volume.
# Dev only: production leaves it unset (the role is created without a
# password) and sets it with ALTER ROLE, see docs/DEPLOY.md.
POSTGRES_APP_PASSWORD=changeme

# ── API Keys ─────────────────────────────────────────────────
# Anthropic — Claude chat completions (research agent, entity graph).
# Empty = those endpoints answer 503.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — only used when Embedding__Provider=OpenAi (text-embedding-3-large).
# Not needed with the default local ONNX embeddings.
OPENAI_API_KEY=sk-...

# Tavily — web search plugin. Empty = the agent is told web search is unavailable.
TAVILY_API_KEY=tvly-...

# ── Auth ─────────────────────────────────────────────────────
# Supabase project URL, e.g. https://abcd.supabase.co. Set = validate
# Supabase-issued ES256/RS256 tokens (OIDC discovery) and remove /api/auth/*.
# Empty = the in-house HS256 identity provider below.
Supabase__Url=
# Supabase__Audience=authenticated

# ── JWT (in-house HS256 identity provider) ───────────────────
# Used only while Supabase__Url is empty. Allowed in Development/Testing;
# anywhere else the API refuses to start unless
# JWT__ALLOWLOCALIDENTITYPROVIDER=true AND Jwt__Secret is a unique secret of
# at least 32 bytes (the development default from appsettings is rejected).
JWT_SECRET=changeme_at_least_32_characters_long
JWT_ISSUER=https://lindrake.local
JWT_AUDIENCE=lindrake-api
JWT__ALLOWLOCALIDENTITYPROVIDER=false

# ── CORS ─────────────────────────────────────────────────────
# Origins allowed to call the API cross-origin. Empty by default outside
# Development; set one entry per origin when the web app and API are on
# different origins (i.e. API_BASE_URL is an absolute URL).
# Cors__AllowedOrigins__0=https://app.example.com

# ── Embeddings ───────────────────────────────────────────────
# Defaults (appsettings.json + the API image) use the local ONNX model
# bge-small-en-v1.5: 384 dimensions, CLS pooling, 512-token window.
# Switching to OpenAi also needs a migration of the vector(384) column;
# startup refuses the dimension mismatch.
# Embedding__Provider=Onnx
# Embedding__ModelPath=models/bge-small-en-v1.5/model.onnx
# Embedding__TokenizerPath=models/bge-small-en-v1.5/vocab.txt
# Embedding__Dimensions=384
# Embedding__MaxSequenceLength=512
# Embedding__Pooling=Cls
# Embedding__QueryInstruction=Represent this sentence for searching relevant passages:
# OpenAI__EmbeddingModel=text-embedding-3-large
# OpenAI__EmbeddingDimensions=3072

# ── Research profile / agent (optional) ──────────────────────
# Unset keys fall back to the built-in family-history profile.
# ResearchProfile__Name=FamilyHistory
# ResearchProfile__ReportTitle={profile} report {date}
# ResearchProfile__EnabledPlugins__0=VectorSearch
# Agent__MaxHistoryMessages=20

# ── Observability (optional) ─────────────────────────────────
# OTLP collector for traces and metrics; unset = console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── ASP.NET Core ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Blazor Frontend ──────────────────────────────────────────
# URL of the backend API as seen by the browser. Written into the web
# container's app/appsettings.json at container start. Empty = same origin
# (the client calls api/... on the host that served it; reverse proxy).
API_BASE_URL=http://localhost:5000
