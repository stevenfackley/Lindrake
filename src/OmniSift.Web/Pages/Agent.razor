@page "/agent"
@implements IDisposable
@inject OmniSiftApiClient Api
@inject MarkdownService Markdown
@inject IJSRuntime JS

<PageTitle>OmniSift — Research Agent</PageTitle>

<div class="page-header">
    <span class="kicker">Research Agent</span>
    <h1>Ask anything. Get it sourced.</h1>
</div>

<div class="card" style="margin-top: 1.5rem;">
    <div class="chat-container">
        <div class="chat-messages">
            @if (_vm.Messages.Count == 0 && !_vm.IsStreaming)
            {
                <div class="empty-state">
                    <span class="eyebrow">▸ ready</span>
                    <p style="font-family: var(--display); font-size: 1.5rem; color: var(--text);">
                        Search your documents, the web, and the archive.
                    </p>
                    <p class="hint">Try: "What addresses did John Smith live at?" or "Find information about…"</p>
                    <ul class="source-tags">
                        <li>&#9656; PDF</li>
                        <li>&#9656; SMS</li>
                        <li>&#9656; WEB</li>
                        <li>&#9656; ARCHIVE</li>
                    </ul>
                </div>
            }

            @foreach (var msg in _vm.Messages)
            {
                <div class="chat-message @msg.Role">
                    @if (msg.Role == ChatRoles.Assistant)
                    {
                        <div class="chat-md">@((MarkupString)Markdown.Render(msg.Content))</div>
                    }
                    else
                    {
                        <div>@((MarkupString)EscapeHtml(msg.Content))</div>
                    }

                    @if (msg.IsIncomplete)
                    {
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">
                            ⚠ Incomplete response
                        </div>
                    }

                    @if (msg.Sources?.Count > 0)
                    {
                        <div class="citations">
                            <div class="citations-label">Sources</div>
                            <ul class="citations-list">
                                @foreach (var src in msg.Sources)
                                {
                                    <li class="citation-card">
                                        <span class="citation-type">@src.Type</span>
                                        @if (!string.IsNullOrWhiteSpace(src.Title))
                                        {
                                            <span class="citation-title">
                                                @if (!string.IsNullOrWhiteSpace(src.Url))
                                                {
                                                    <a href="@src.Url" target="_blank" rel="noopener noreferrer">@src.Title</a>
                                                }
                                                else
                                                {
                                                    @src.Title
                                                }
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(src.Url))
                                        {
                                            <a class="citation-url" href="@src.Url" target="_blank" rel="noopener noreferrer">@src.Url</a>
                                        }
                                        @if (src.RelevanceScore.HasValue)
                                        {
                                            <span class="citation-score">@(src.RelevanceScore.Value.ToString("F2"))</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (msg.PluginsUsed?.Count > 0)
                    {
                        <div class="chat-plugins">
                            @foreach (var plugin in msg.PluginsUsed)
                            {
                                <span class="plugin-tag">@plugin</span>
                            }
                        </div>
                    }
                    @if (msg.DurationMs > 0)
                    {
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">
                            ⏱ @(msg.DurationMs)ms
                        </div>
                    }
                </div>
            }

            @if (_vm.IsStreaming)
            {
                <div class="chat-message assistant">
                    @if (string.IsNullOrEmpty(_vm.StreamingText))
                    {
                        <div class="spinner" style="width: 24px; height: 24px; border-width: 3px;"></div>
                        <span style="margin-left: 0.5rem; color: var(--text-muted);">Thinking…</span>
                    }
                    else
                    {
                        <div class="chat-md">@((MarkupString)Markdown.Render(_vm.StreamingText))</div>
                    }
                </div>
            }
        </div>

        <div class="chat-input-area">
            <textarea class="form-textarea"
                      @bind="_currentQuery"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="Ask a research question..."
                      disabled="@_vm.IsStreaming"></textarea>
            @if (_vm.IsStreaming)
            {
                <button class="btn btn-outline" @onclick="_vm.Stop">
                    Stop
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="SendQuery" disabled="@(!_vm.CanSend(_currentQuery))">
                    Send
                </button>
            }
        </div>
    </div>
</div>

@if (_vm.Messages.Count > 0)
{
    <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
        <button class="btn btn-outline btn-sm" @onclick="DownloadPdf" disabled="@(_vm.IsStreaming || _vm.IsGeneratingReport)">
            @if (_vm.IsGeneratingReport)
            {
                <span class="spinner" style="width: 12px; height: 12px; border-width: 2px;"></span>
                <span>Generating…</span>
            }
            else
            {
                <span>⬇ Download report (PDF)</span>
            }
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_vm.Error))
{
    <div class="alert alert-error" style="margin-top: 1rem;">@_vm.Error</div>
}

@code {
    private AgentChatViewModel _vm = default!;
    private string _currentQuery = string.Empty;

    protected override void OnInitialized()
    {
        _vm = new AgentChatViewModel(Api);
        _vm.Changed += HandleChanged;
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private async Task SendQuery()
    {
        if (!_vm.CanSend(_currentQuery))
            return;

        var query = _currentQuery;
        _currentQuery = string.Empty;
        await _vm.SendAsync(query);
    }

    private async Task DownloadPdf()
    {
        if (await _vm.GenerateReportAsync() is not { } pdf)
            return;

        try
        {
            await JS.InvokeVoidAsync("downloadBlobFile", "report.pdf", "application/pdf", pdf);
        }
        catch (JSException ex)
        {
            _vm.ReportError($"PDF download failed: {ex.Message}");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendQuery();
    }

    private static string EscapeHtml(string content) =>
        content
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\n", "<br/>");

    public void Dispose()
    {
        _vm.Changed -= HandleChanged;
        _vm.Dispose();
    }
}
