{
  // ConnectionStrings:DefaultConnection has no default here: Development reads
  // appsettings.Development.json (the compose db as omnisift_app), the compose
  // api service sets it from the environment, production from a Docker secret.
  "Anthropic": {
    "ApiKey": "",
    "ModelId": "claude-sonnet-4-20250514"
  },
  "OpenAI": {
    "ApiKey": "",
    "EmbeddingModel": "text-embedding-3-large",
    "EmbeddingDimensions": 3072
  },
  "Embedding": {
    "Provider": "Onnx",
    "ModelPath": "models/bge-small-en-v1.5/model.onnx",
    "TokenizerPath": "models/bge-small-en-v1.5/vocab.txt",
    "Dimensions": 384,
    "Pooling": "Cls",
    "QueryInstruction": "Represent this sentence for searching relevant passages: "
  },
  "Tavily": {
    "ApiKey": ""
  },
  // Research profile: the agent's system prompt, kernel plugins and report title.
  // Keys left out fall back to the built-in family-history profile
  // (ResearchProfiles.FamilyHistory in Lindrake.Api), i.e. the defaults are:
  //   "SystemPrompt":   the built-in family-history research prompt
  //   "EnabledPlugins": [ "VectorSearch", "WebScraper", "WaybackMachine" ]  (absent = all)
  // EnabledPlugins is deliberately not set here: configuration sources merge
  // arrays index by index, so a profile file listing fewer plugins could not
  // remove one. ReportTitle supports the {profile} and {date} tokens.
  "ResearchProfile": {
    "Name": "FamilyHistory",
    "ReportTitle": "Research Report"
  },
  "Agent": {
    "MaxHistoryMessages": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "Lindrake",
    "Audience": "Lindrake",
    "ExpiryMinutes": 60
  },
  "Supabase": {
    "Url": "",
    "Audience": "authenticated"
  },
  "AllowedHosts": "*"
}
