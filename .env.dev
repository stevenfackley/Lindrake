# ============================================================
# OmniSift — Development Environment
# Used by: docker compose (local dev).
#
# docker-compose.yml defaults every value it interpolates (POSTGRES_*, API keys,
# JWT_*) to the value here, so `docker compose up` works without --env-file.
# Compose only reads your edits to those keys with
#   docker compose --env-file .env.dev up --build
# ASPNETCORE_ENVIRONMENT and API_BASE_URL reach the containers through
# env_file either way.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=omnisift
POSTGRES_PASSWORD=omnisift_dev
POSTGRES_DB=omnisift
# omnisift_app: the role the API connects as, created by infra/db/init.sql on
# the first start of an empty volume. RLS binds it; the superuser above
# bypasses RLS, so never point the API at the superuser. The host-run API's
# connection string (appsettings.Development.json) uses the same password.
POSTGRES_APP_PASSWORD=omnisift_dev

# ── API Keys ─────────────────────────────────────────────────
# Set your personal dev keys — do not use prod keys locally. Empty = the agent
# and entity endpoints answer 503 (Anthropic) / web search is reported
# unavailable (Tavily); OpenAI is only used with Embedding__Provider=OpenAi.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# ── JWT ──────────────────────────────────────────────────────
# The public development secret (also in appsettings.Development.json); the API
# refuses it outside Development/Testing.
JWT_SECRET=dev-only-hs256-secret-not-for-production-use
JWT_ISSUER=https://omnisift.local
JWT_AUDIENCE=omnisift-api

# ── ASP.NET Core ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Blazor Frontend ──────────────────────────────────────────
API_BASE_URL=http://localhost:5000
