# Build output
bin/
obj/
out/
publish/
**/Release/
**/Debug/

# Local ML model artifacts (e.g. bge-small-en-v1.5 ONNX, ~133 MB) — never commit
models/
.verify-publish/
.verify-site/

# Test results
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage*/

# NuGet
*.nupkg
*.snupkg
.nuget/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opendb
*.dbcache
*.docs.dll

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Rider
.idea/

# Windows
Thumbs.db
Desktop.ini

# SQL Server
*.mdf
*.ldf
*.ndf

# Environment files
# .env.dev and .env.test are safe to commit (no real secrets)
# .env and .env.prod are gitignored — populate via secrets manager
.env
.env.prod

# Docker secrets — plain-text secret files (never commit)
secrets/*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# Lindrake
# Local ONNX embedding model (~130 MB) — fetched via scripts/fetch-embedding-model.ps1
/models/
infra/db/data/
logs/
temp/
/.dotnet-cli/.dotnet
/.dotnet
*.lscache
